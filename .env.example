# ── Inteligencia Artificial (SIEMPRE en env var, nunca hardcodeada — ver 30) ─
AI_MODEL=claude-sonnet-4-6
AI_MODEL_FALLBACK=
ANTHROPIC_API_KEY=                    # SOLO servidor — jamás NEXT_PUBLIC_
AI_DAILY_BUDGET_USD=20                # kill-switch de gasto diario
AI_MONTHLY_BUDGET_USD=250             # kill-switch de gasto mensual

# ── Transcripción de video/audio (AssemblyAI) ────────────────────────────────
ASSEMBLYAI_API_KEY=                   # SOLO servidor

# ── Supabase (nomenclatura nueva: publishable/secret) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxx    # SOLO servidor — jamás NEXT_PUBLIC_

# ── Venta (Hotmart) — se completa en el paso de checkout real ───────────────
HOTMART_HOTTOK=

# ── Email transaccional (Resend) — se completa en el paso de emails ─────────
RESEND_API_KEY=
EMAIL_FROM=hola@tudominio.com
